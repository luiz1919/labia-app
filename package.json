{
  "name": "labia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:rules": "firebase emulators:exec --config firebase.emulator.json --project demo-labia --only firestore \"node --test tests/firestore.rules.test.mjs\"",
    "preview": "vite preview",
    "deploy": "node scripts/deploy.mjs",
    "deploy:check": "node scripts/deploy.mjs --check"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "firebase-app-kit": "github:luiz1919/firebase-app-kit#v0.10.0",
    "lucide-react": "^1.67.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}
