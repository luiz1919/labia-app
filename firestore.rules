rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validProvider(provider) {
      return provider is map && provider.keys().hasOnly(['apiKey', 'model', 'models'])
        && (!('apiKey' in provider) || (provider.apiKey is string && provider.apiKey.size() <= 500))
        && (!('model' in provider) || (provider.model is string && provider.model.size() <= 200))
        && (!('models' in provider) || (provider.models is list && provider.models.size() <= 500));
    }
    function validProviders(providers) {
      return providers is map && providers.keys().hasOnly(['anthropic', 'gemini', 'openai'])
        && (!('anthropic' in providers) || validProvider(providers.anthropic))
        && (!('gemini' in providers) || validProvider(providers.gemini))
        && (!('openai' in providers) || validProvider(providers.openai));
    }
    // users/{uid}: the user's preferences (the language pair). Language codes are checked by
    // shape only (ISO 639: two or three lowercase letters), so adding a language to the app
    // does not require new rules.
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['sourceLanguage', 'targetLanguage'])
        && request.resource.data.sourceLanguage is string && request.resource.data.sourceLanguage.matches('^[a-z]{2,3}$')
        && request.resource.data.targetLanguage is string && request.resource.data.targetLanguage.matches('^[a-z]{2,3}$')
        && request.resource.data.sourceLanguage != request.resource.data.targetLanguage;
    }
    // users/{uid}/settings/ai: the user's own AI keys and models (firebase-app-kit/ai shape,
    // same document as CommunityAssistant). Only the owner can read or change it.
    match /users/{uid}/settings/ai {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['providers', 'lastProvider', 'anthropicFallback'])
        && (!('providers' in request.resource.data) || validProviders(request.resource.data.providers))
        && (!('lastProvider' in request.resource.data) || request.resource.data.lastProvider == null
          || request.resource.data.lastProvider in ['anthropic', 'gemini', 'openai'])
        && (!('anthropicFallback' in request.resource.data) || request.resource.data.anthropicFallback is bool);
    }
    // users/{uid}/pantry/{itemId}: words saved to look up later ("Despensa"). createdAt is set
    // by the server when the word is added and never changes.
    function validPantryItem(data) {
      return data.keys().hasOnly(['text', 'lang', 'createdAt', 'reviewed'])
        && data.keys().hasAll(['text', 'lang', 'createdAt', 'reviewed'])
        && data.text is string && data.text.size() > 0 && data.text.size() <= 100
        && data.lang is string && data.lang.matches('^[a-z]{2,3}$')
        && data.createdAt is timestamp
        && data.reviewed is bool;
    }
    match /users/{uid}/pantry/{itemId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && validPantryItem(request.resource.data) && request.resource.data.createdAt == request.time;
      allow update: if request.auth != null && request.auth.uid == uid
        && validPantryItem(request.resource.data) && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.lang == resource.data.lang;
    }
    // users/{uid}/favorites/{favoriteId}: starred searches. The id comes from the direction and
    // the query, so starring again overwrites; createdAt is the server time of the last star.
    function validFavorite(data) {
      return data.keys().hasOnly(['term', 'source', 'target', 'translations', 'engine', 'createdAt'])
        && data.keys().hasAll(['term', 'source', 'target', 'translations', 'engine', 'createdAt'])
        && data.term is string && data.term.size() > 0 && data.term.size() <= 200
        && data.source is string && data.source.matches('^[a-z]{2,3}$')
        && data.target is string && data.target.matches('^[a-z]{2,3}$')
        && data.source != data.target
        && data.translations is list && data.translations.size() <= 8
        && data.engine is string && data.engine.size() <= 40
        && data.createdAt == request.time;
    }
    match /users/{uid}/favorites/{favoriteId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && favoriteId.size() <= 1000 && validFavorite(request.resource.data);
    }
    // users/{uid}/idioms/{idiomId}: the user's own expressions ("Expresiones" > "Nueva
    // expresión"), shaped like the bundled idioms (src/data/types.ts Idiom). Rules cannot look
    // inside every list item, so they bound the sizes and the app reads the content defensively
    // (src/ownIdioms.ts parseOwnIdiom). createdAt is the server time of the first save.
    function validOwnIdiom(data) {
      return data.keys().hasOnly(['meaning', 'expressions', 'example', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['meaning', 'expressions', 'example', 'createdAt', 'updatedAt'])
        && data.meaning is string && data.meaning.size() <= 500
        && data.expressions is list && data.expressions.size() >= 2 && data.expressions.size() <= 20
        && data.expressions[0] is map && data.expressions[1] is map
        && data.example is map && data.example.size() <= 10
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }
    match /users/{uid}/idioms/{idiomId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && idiomId.size() <= 100 && validOwnIdiom(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if request.auth != null && request.auth.uid == uid
        && validOwnIdiom(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    // <firebase-app-kit:feedback>
    // In-app feedback ("Comentarios"), copied from firebase-app-kit/rules/feedback.rules. Do not
    // edit it here: update it with `npx firebase-app-kit rules` (the deploy fails if it is outdated).
    // Every signed-in user reads the feedback (so nobody repeats a suggestion); only its author
    // edits the kind, the title and the description (text); admins (a document admins/{uid}, created by hand in the Firebase
    // console) set the status, the reply and the version, and delete. Technical details only travel
    // with new feedback; its author can add screenshots later (never replace them), up to 3. Only
    // the author and admins can read either.
    function feedbackSignedIn() {
      return request.auth != null
        && request.auth.token.get('firebase', {}).get('sign_in_provider', '') != 'anonymous';
    }
    function feedbackAdmin() {
      return feedbackSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function feedbackPath(feedbackId) {
      return /databases/$(database)/documents/feedback/$(feedbackId);
    }
    function feedbackAuthorOrAdmin(feedbackId) {
      return feedbackAdmin()
        || (feedbackSignedIn() && get(feedbackPath(feedbackId)).data.createdBy == request.auth.uid);
    }
    function feedbackCreatingOwn(feedbackId) {
      return feedbackSignedIn() && !exists(feedbackPath(feedbackId))
        && getAfter(feedbackPath(feedbackId)).data.createdBy == request.auth.uid;
    }
    // The author's edit adds a screenshot after the ones it had (screenshotCount before the edit).
    function feedbackAddingOwnScreenshot(feedbackId, index) {
      return feedbackSignedIn() && exists(feedbackPath(feedbackId))
        && get(feedbackPath(feedbackId)).data.createdBy == request.auth.uid
        && int(index) >= get(feedbackPath(feedbackId)).data.screenshotCount;
    }
    function feedbackString(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }
    // A title (feedback from v0.12.0 has none until its author edits it) and an optional description.
    function feedbackContent(data) {
      return data.kind in ['bug', 'idea', 'other'] && feedbackString(data.title, 1, 120)
        && feedbackString(data.text, 0, 4000);
    }
    function feedbackNew(data) {
      return data.keys().hasOnly(['kind', 'title', 'text', 'status', 'createdBy', 'createdByEmail', 'createdAt', 'editedAt',
          'appVersion', 'screenshotCount', 'hasDiagnostics', 'reply', 'repliedAt', 'replyRead', 'resolvedVersion'])
        && data.keys().hasAll(['kind', 'title', 'text', 'status', 'createdBy', 'createdByEmail', 'createdAt', 'editedAt',
          'appVersion', 'screenshotCount', 'hasDiagnostics', 'reply', 'repliedAt', 'replyRead', 'resolvedVersion'])
        && feedbackContent(data)
        && data.status == 'new'
        && data.createdBy == request.auth.uid
        && data.createdByEmail == request.auth.token.get('email', '')
        && data.createdAt == request.time
        && data.editedAt == null
        && feedbackString(data.appVersion, 0, 40)
        && data.screenshotCount is int && data.screenshotCount >= 0 && data.screenshotCount <= 3
        && data.hasDiagnostics is bool
        && data.reply == '' && data.repliedAt == null && data.replyRead == true
        && data.resolvedVersion == '';
    }
    // The author edits the kind, the title and the description and adds screenshots (stamping
    // editedAt), and marks the reply as read (also on feedback without a title).
    function feedbackAuthorEdit() {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      let edited = changed.hasAny(['kind', 'title', 'text', 'editedAt', 'screenshotCount']);
      return resource.data.createdBy == request.auth.uid
        && changed.hasOnly(['kind', 'title', 'text', 'editedAt', 'screenshotCount', 'replyRead'])
        && (!edited || (feedbackContent(data) && data.editedAt == request.time))
        && (!changed.hasAny(['screenshotCount'])
          || (data.screenshotCount is int && data.screenshotCount > resource.data.screenshotCount && data.screenshotCount <= 3))
        && (!changed.hasAny(['replyRead']) || data.replyRead == true);
    }
    // Admins set the status, the reply (stamping repliedAt, or null when it is cleared) and the version.
    function feedbackAdminEdit() {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['status', 'reply', 'repliedAt', 'replyRead', 'resolvedVersion'])
        && data.status in ['new', 'in-progress', 'done', 'declined']
        && feedbackString(data.reply, 0, 4000)
        && feedbackString(data.resolvedVersion, 0, 40)
        && data.replyRead is bool
        && (changed.hasAny(['reply', 'repliedAt'])
          ? (data.reply == '' ? data.repliedAt == null : data.repliedAt == request.time)
          : true);
    }
    match /admins/{uid} {
      allow get: if feedbackSignedIn() && request.auth.uid == uid;
    }
    match /feedback/{feedbackId} {
      allow read: if feedbackSignedIn();
      allow create: if feedbackSignedIn() && feedbackNew(request.resource.data);
      allow update: if feedbackSignedIn() && (feedbackAuthorEdit() || (feedbackAdmin() && feedbackAdminEdit()));
      allow delete: if feedbackAdmin();

      // Screenshots: JPEG in one chunk each (firebase-app-kit chunk format), 0 to screenshotCount - 1.
      match /screenshots/{index} {
        allow read: if feedbackAuthorOrAdmin(feedbackId);
        allow create: if index in ['0', '1', '2']
          && (feedbackCreatingOwn(feedbackId) || feedbackAddingOwnScreenshot(feedbackId, index))
          && int(index) < getAfter(feedbackPath(feedbackId)).data.screenshotCount
          && request.resource.data.keys().hasOnly(['index', 'type', 'size', 'width', 'height', 'chunkCount'])
          && request.resource.data.keys().hasAll(['index', 'type', 'size', 'width', 'height', 'chunkCount'])
          && request.resource.data.index == int(index)
          && request.resource.data.type == 'image/jpeg'
          && request.resource.data.size is int && request.resource.data.size > 0 && request.resource.data.size <= 768000
          && request.resource.data.width is int && request.resource.data.width > 0 && request.resource.data.width <= 4096
          && request.resource.data.height is int && request.resource.data.height > 0 && request.resource.data.height <= 4096
          && request.resource.data.chunkCount == 1;
        allow delete: if feedbackAdmin();

        match /chunks/{chunkId} {
          allow read: if feedbackAuthorOrAdmin(feedbackId);
          allow create: if index in ['0', '1', '2']
            && (feedbackCreatingOwn(feedbackId) || feedbackAddingOwnScreenshot(feedbackId, index))
            && chunkId == '0000'
            && request.resource.data.keys().hasOnly(['index', 'data'])
            && request.resource.data.keys().hasAll(['index', 'data'])
            && request.resource.data.index == 0
            && request.resource.data.data is bytes
            && request.resource.data.data.size() == getAfter(/databases/$(database)/documents/feedback/$(feedbackId)/screenshots/$(index)).data.size;
          allow delete: if feedbackAdmin();
        }
      }

      // Technical details (app version, browser, screen, recent errors): private/diagnostics.
      match /private/{name} {
        allow read: if feedbackAuthorOrAdmin(feedbackId);
        allow create: if feedbackCreatingOwn(feedbackId)
          && name == 'diagnostics'
          && getAfter(feedbackPath(feedbackId)).data.hasDiagnostics == true
          && request.resource.data.keys().hasOnly(['context', 'errors'])
          && request.resource.data.keys().hasAll(['context', 'errors'])
          && request.resource.data.context is map && request.resource.data.context.size() <= 30
          && request.resource.data.errors is list && request.resource.data.errors.size() <= 20;
        allow delete: if feedbackAdmin();
      }
    }
    // </firebase-app-kit:feedback>

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
